{
  "$schema-note": "Colour tokens for requirement-manager. THE source: app/src/styles/colors_and_type.css and the <style> block in plugin/scripts/reqmap_engine/site_template.py are both generated from this file by scripts/gen_tokens.py. Edit here, never there.",
  "themes": {
    "light": {
      "name": "Paper",
      "selector": ":root"
    },
    "dark": {
      "name": "Night",
      "selector": "[data-theme=\"dark\"]"
    },
    "hc": {
      "name": "High contrast",
      "selector": "[data-theme=\"hc\"]",
      "also": "@media (prefers-contrast: more), on :root when no dark theme is set"
    }
  },
  "rules": [
    "A value is a hex colour, an rgb()/rgba() colour, or {other-token} meaning var(--other-token).",
    "A token with no value for a theme inherits the light one, exactly as the CSS cascade does.",
    "Corrections move only L in OKLCH: hue and chroma stay, so the mark does not shift.",
    "Non-colour custom properties (type, spacing, radii, shadows, motion) stay hand-written in colors_and_type.css. They never diverged between the two surfaces, and the engine's site does not use them."
  ],
