#!/usr/bin/env bash
# implements: ARCH-SELFGATE-039
# Block direct pushes to main/master (mirrors the global ~/.git-hooks guard).
# Repo-tracked here because this repo sets `core.hooksPath .githooks`, which
# overrides the global hooksPath — without this copy the global guard would not
# run for this repo. Bypass once:  git push --no-verify
while read local_ref local_sha remote_ref remote_sha; do
    if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/master" ]]; then
        echo "ERROR: push direct pe main/master e blocat."
        echo "Creează un branch: git checkout -b feat/<slug> sau fix/<slug>"
        exit 1
    fi
done
exit 0
