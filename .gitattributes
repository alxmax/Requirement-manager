# The git hook is executed by /bin/sh — it must keep LF endings even on Windows
# checkouts, or sh chokes on the CR.
plugin/hooks/pre-commit text eol=lf

# Committed BUILD ARTIFACTS and the template one of them inlines verbatim. Without a
# pinned eol these files differ by the platform that produced them: on Windows the
# viewer template checks out CRLF and Vite copies those bytes straight into the bundle,
# and Python's default newline translation did the same to the diagram. `core.autocrlf`
# then hid it locally (it normalizes on the way in), so the mismatch only appeared in
# CI, on Linux, as a whole-file diff of visually identical lines. ARCH-REPRO-041's job
# compares these byte for byte, so their line endings have to be a property of the repo
# rather than of the machine that last built them.
app/viewer.html text eol=lf
plugin/scripts/_map_viewer.html text eol=lf
docs/full_architecture.html text eol=lf

# GENERATED artifacts: never merged, always regenerated. Two branches that both ran
# `sync` produce two versions of the same derived file, and the only correct resolution
# is to re-derive it from the merged corpus — never to reconcile the marker hunks by
# hand. `merge=ours` keeps the current branch's copy so the merge itself never stops on
# them; the gate's map-freshness check then fails until `sync` is re-run, which is the
# loud, self-correcting signal. (The header of _map.md is content-derived since
# v4.0.0, so identical graphs no longer differ at all.)
plugin/requirements/_map.md merge=ours
plugin/requirements/_map.json merge=ours
plugin/requirements/_findings.md merge=ours
plugin/requirements/_reqlock.json merge=ours
plugin/requirements/_memberlock.json merge=ours
docs/map.html merge=ours
